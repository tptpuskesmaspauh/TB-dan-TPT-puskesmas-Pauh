{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Akun petugas dan tenaga kesehatan UPTD Puskesmas Pauh yang terdaftar di TEMAN TPT dengan kontrol akses berbasis peran (RBAC).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "faskesCode": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["super_admin", "admin_puskesmas", "petugas_tb", "nakes"] },
        "roleLabel": { "type": "string", "maxLength": 100 },
        "nip": { "type": "string", "maxLength": 40 },
        "phone": { "type": "string", "maxLength": 32 },
        "avatar": { "type": "string", "maxLength": 300 },
        "isActive": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "faskesCode", "name", "email", "role", "isActive", "createdAt", "updatedAt"]
    },
    "IndexPatient": {
      "title": "IndexPatient",
      "description": "Data ringkas pasien TB aktif sebagai pasien indeks untuk pelacakan kontak erat dan pengingat kepatuhan.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "faskesCode": { "type": "string", "minLength": 1, "maxLength": 32 },
        "nomorRegisterSitb": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sitbRecorded": { "type": "boolean" },
        "sitbRecordedDate": { "type": "string", "maxLength": 32 },
        "sitbRecordedBy": { "type": "string", "maxLength": 120 },
        "nik": { "type": "string", "maxLength": 32 },
        "noRekamMedis": { "type": "string", "maxLength": 50 },
        "namaLengkap": { "type": "string", "minLength": 1, "maxLength": 150 },
        "jenisKelamin": { "type": "string", "enum": ["L", "P"] },
        "tanggalLahir": { "type": "string", "maxLength": 32 },
        "umur": { "type": "number" },
        "alamat": { "type": "string", "maxLength": 300 },
        "kelurahan": { "type": "string", "minLength": 1, "maxLength": 80 },
        "noWhatsApp": { "type": "string", "maxLength": 32 },
        "namaPendamping": { "type": "string", "maxLength": 150 },
        "hubunganPendamping": { "type": "string", "maxLength": 60 },
        "noWhatsAppPendamping": { "type": "string", "maxLength": 32 },
        "tanggalDiagnosis": { "type": "string", "maxLength": 32 },
        "klasifikasi": { "type": "string", "enum": ["Paru", "Ekstraparu"] },
        "lokasiAnatomi": { "type": "string", "maxLength": 150 },
        "hasilBakteriologis": { "type": "string", "maxLength": 100 },
        "tanggalMulaiOAT": { "type": "string", "maxLength": 32 },
        "fasyankes": { "type": "string", "maxLength": 120 },
        "petugasPenanggungJawab": { "type": "string", "maxLength": 120 },
        "regimenOAT": { "type": "string", "maxLength": 120 },
        "fasePengobatan": { "type": "string", "maxLength": 60 },
        "statusPengobatan": { "type": "string", "maxLength": 60 },
        "perkiraanSelesai": { "type": "string", "maxLength": 32 },
        "komorbiditas": { "type": "array" },
        "catatanKlinis": { "type": "string", "maxLength": 1000 },
        "kepatuhanMinumObat": { "type": "string", "maxLength": 60 },
        "jadwalAmbilObatBerikutnya": { "type": "string", "maxLength": 32 },
        "jadwalAmbilObatTerakhir": { "type": "string", "maxLength": 32 },
        "sisaObatHari": { "type": "number" },
        "pernahTerlambat": { "type": "boolean" },
        "jumlahKeterlambatan": { "type": "number" },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "faskesCode", "nomorRegisterSitb", "sitbRecorded", "namaLengkap", "jenisKelamin", "kelurahan", "statusPengobatan", "createdByUid", "createdAt", "updatedAt"]
    },
    "CloseContact": {
      "title": "CloseContact",
